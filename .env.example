PORT=5008
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=turf_sports_db

# Storage Provider (local | s3 | cloudinary)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Payment Provider Adapter (mock | razorpay)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Centralized Domain Configuration
APP_URL=https://playzo.duckdns.org
API_PUBLIC_URL=https://playzo.duckdns.org/api
CORS_ORIGIN=https://playzo.duckdns.org,http://playzo.duckdns.org,http://localhost:3001,http://localhost:3000

# Email / SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="PlayZo" <your_email@gmail.com>

# Live Match Streaming Configuration (WebRTC / RTMP / HLS / STUN / TURN)
STREAMING_RTMP_INGEST_URL=rtmp://playzo.duckdns.org/live
STREAMING_HLS_PLAYBACK_URL=https://playzo.duckdns.org/live
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
WEBRTC_ICE_SERVERS=

# Super Admin Production Account Seeder / Migration Configuration
# Set these on production server prior to running `npm run migrate` or `npm run seed:superadmin`
SEED_SUPERADMIN_EMAIL=kundanyadav96197@gmail.com
SEED_SUPERADMIN_PASSWORD=your_secure_superadmin_password_here
# Optional: Set to true if you need to reset the existing Super Admin password during migration
SEED_SUPERADMIN_RESET_PASSWORD=false


